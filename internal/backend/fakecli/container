#!/usr/bin/env bash
# Minimal fake of Apple's `container` CLI for unit/CI tests.
# Emits JSON shapes matching container 1.2.x.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
DATA="${FAKE_CONTAINER_DATA:-$ROOT/../testdata}"

cmd="${1:-}"
shift || true

case "$cmd" in
  list|ls)
    cat "$DATA/list.json"
    ;;
  inspect)
    cat "$DATA/inspect.json"
    ;;
  start|stop)
    id="${1:-}"
    echo "ok $cmd $id" >&2
    ;;
  delete|rm)
    # consume optional --force
    while [[ "${1:-}" == --* ]]; do shift || true; done
    id="${1:-}"
    echo "ok delete $id" >&2
    ;;
  stats)
    cat "$DATA/stats.json"
    ;;
  logs)
    # support -n N and --follow
    n=100
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -n) n="$2"; shift 2 ;;
        --follow|-f) shift ;;
        *) id="$1"; shift ;;
      esac
    done
    for i in $(seq 1 "$n"); do
      echo "fake log line $i for ${id:-unknown}"
    done
    ;;
  image)
    sub="${1:-}"; shift || true
    case "$sub" in
      list|ls) cat "$DATA/images.json" ;;
      inspect) cat "$DATA/image-inspect.json" ;;
      delete|rm) echo "ok image delete ${1:-}" >&2 ;;
      pull) echo "ok image pull ${1:-}" >&2 ;;
      *) echo "unknown image subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  volume)
    sub="${1:-}"; shift || true
    case "$sub" in
      list|ls) cat "$DATA/volumes.json" ;;
      inspect) cat "$DATA/volume-inspect.json" ;;
      delete|rm) echo "ok volume delete ${1:-}" >&2 ;;
      *) echo "unknown volume subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  exec)
    echo "fake exec $*" >&2
    ;;
  system)
    sub="${1:-}"; shift || true
    case "$sub" in
      status)
        if [[ "${FAKE_CONTAINER_SYSTEM_DOWN:-}" == "1" ]]; then
          cat "$DATA/system-status-down.json"
          exit 1
        fi
        cat "$DATA/system-status.json"
        ;;
      df)
        if [[ "${FAKE_CONTAINER_SYSTEM_DOWN:-}" == "1" ]]; then
          echo 'Error: interrupted: "XPC connection error: Connection invalid"' >&2
          echo "Ensure container system service has been started with \`container system start\`." >&2
          exit 1
        fi
        cat "$DATA/system-df.json"
        ;;
      *) echo "unknown system subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "fake-container: unknown command: $cmd $*" >&2
    exit 1
    ;;
esac
