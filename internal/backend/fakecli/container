#!/usr/bin/env bash
# Minimal fake of Apple's `container` CLI for unit/CI tests.
# Emits JSON shapes matching container 1.2.x.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
DATA="${FAKE_CONTAINER_DATA:-$ROOT/../testdata}"

cmd="${1:-}"
shift || true

case "$cmd" in
  list|ls)
    cat "$DATA/list.json"
    ;;
  inspect)
    cat "$DATA/inspect.json"
    ;;
  start|stop)
    id="${1:-}"
    echo "ok $cmd $id" >&2
    ;;
  delete|rm)
    # consume optional --force
    while [[ "${1:-}" == --* ]]; do shift || true; done
    id="${1:-}"
    echo "ok delete $id" >&2
    ;;
  stats)
    cat "$DATA/stats.json"
    ;;
  logs)
    # support -n N and --follow
    n=100
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -n) n="$2"; shift 2 ;;
        --follow|-f) shift ;;
        *) id="$1"; shift ;;
      esac
    done
    for i in $(seq 1 "$n"); do
      echo "fake log line $i for ${id:-unknown}"
    done
    ;;
  image)
    sub="${1:-}"; shift || true
    case "$sub" in
      list|ls) cat "$DATA/images.json" ;;
      delete|rm) echo "ok image delete ${1:-}" >&2 ;;
      pull) echo "ok image pull ${1:-}" >&2 ;;
      tag) echo "ok image tag $*" >&2 ;;
      save) echo "ok image save $*" >&2 ;;
      load) echo "ok image load $*" >&2 ;;
      push)
        case "${FAKE_CONTAINER_FAIL_PUSH:-}" in
          auth)
            echo "Error: HTTP request to https://registry-1.docker.io/v2/library/foo/blobs/sha256:abc failed with response: 401 Unauthorized. Reason: Unknown, no credentials found for host registry-1.docker.io" >&2
            exit 1
            ;;
          forbidden)
            echo "Error: HTTP request to https://registry-1.docker.io/v2/myorg/app/blobs/uploads/ failed with response: 403 Forbidden. Reason: requested access to the resource is denied" >&2
            exit 1
            ;;
          generic)
            # The real CLI echoes the reference back into stderr; keep that so
            # tests exercise a reference whose own words look like an auth error.
            echo "Error: image with reference $*: unexpected network failure" >&2
            exit 1
            ;;
        esac
        echo "ok image push $*" >&2
        ;;
      *) echo "unknown image subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  volume)
    sub="${1:-}"; shift || true
    case "$sub" in
      list|ls) cat "$DATA/volumes.json" ;;
      delete|rm) echo "ok volume delete ${1:-}" >&2 ;;
      *) echo "unknown volume subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  exec)
    echo "fake exec $*" >&2
    ;;
  *)
    echo "fake-container: unknown command: $cmd $*" >&2
    exit 1
    ;;
esac
